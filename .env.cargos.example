# Integrazione CaRGOS (Polizia di Stato) — variabili d'ambiente
#
# Nessuna di queste variabili è impostata: l'adapter attivo è il MOCK, che non
# contatta mai il portale. Per passare al canale reale servono le credenziali
# rilasciate dalla Questura/portale CaRGOS e, soprattutto, la verifica del
# tracciato record riga per riga sul manuale ufficiale.

# "mock" (default, nessun invio reale) oppure "live"
CARGOS_MODE=mock

# Endpoint del portale (default: https://cargos.poliziadistato.it/CARGOS_API/)
CARGOS_BASE_URL=

# Credenziali Basic Auth del servizio
CARGOS_USERNAME=
CARGOS_PASSWORD=

# ApiKey e codice organizzazione forniti dal portale
CARGOS_APIKEY=
CARGOS_ORGANIZATION=

# Sbloccare l'invio definitivo SOLO dopo aver confrontato CARGOS_FIELDS
# (src/lib/cargos.ts) con il tracciato del manuale ufficiale.
CARGOS_TRACCIATO_VERIFICATO=

# Sbloccare l'invio definitivo SOLO dopo aver verificato sul manuale ufficiale
# il formato di cifratura del token (algoritmo AES/3DES in base alla lunghezza
# dell'ApiKey, modalita ECB/CBC, eventuale IV, encoding hex/base64).
# Blocco indipendente e cumulativo rispetto a CARGOS_TRACCIATO_VERIFICATO.
CARGOS_CIFRATURA_VERIFICATA=

# NOTA PER LA DOCUMENTAZIONE INTERNA/STAFF: i nomi delle variabili qui elencati
# sono gli unici letti dal codice. In particolare la chiave e CARGOS_APIKEY
# (senza underscore fra API e KEY): qualunque istruzione operativa deve usare
# esattamente questa dicitura.
