# Prenotazione sul sito collegata al gestionale We Rent (lotto 7b).
#
# SVILUPPO SUL MAC: copiare in .env.development.local (vale solo con "npm run dev",
# mai nella pubblicazione) e compilare la chiave.
#
# PRODUZIONE (dopo la pubblicazione del gestionale su Aruba, Fase 8):
#   - WERENT_API_URL come variabile del Worker, WERENT_API_KEY come segreto
#     (npx wrangler secret put WERENT_API_KEY);
#   - pubblicare con VITE_BOOKING_ENGINE=werent.
# Finché VITE_BOOKING_ENGINE non è "werent" il sito resta sull'iframe RentHub.

VITE_BOOKING_ENGINE=werent
WERENT_API_URL=http://localhost:8080
# Chiave creata nel gestionale: Impostazioni → Collegamento con il sito
WERENT_API_KEY=
